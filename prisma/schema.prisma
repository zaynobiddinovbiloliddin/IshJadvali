datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Mirrors the shape of data/mock-db.json 1:1 so server.mjs can load the
// entire in-memory `db` snapshot from Postgres and write it back unchanged —
// the route handlers and response shaping stay untouched, guaranteeing the
// API contract the frontend (src/main.jsx) depends on does not shift.

model Employee {
  id         Int      @id @default(autoincrement())
  name       String
  role       String   @default("Operator")
  phone      String   @default("+998 90 000 00 00")
  telegram   String   @default("")
  department String   @default("operator")
  avatar     String   @default("") @db.Text
  address    String   @default("")
  portfolio  Json     @default("[]")
  documents  Json     @default("{}")
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model User {
  id         Int      @id @default(autoincrement())
  username   String   @unique
  pinCode    String
  fullName   String
  role       String   @default("xodim")
  isActive   Boolean  @default(true)
  // Set when an account is auto-created alongside a new employee
  // (server.mjs createEmployee). Written but never read back by the
  // server today — kept for perfect round-trip fidelity.
  employeeId Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Contact {
  id        String   @id
  type      String   @default("Muxbir")
  name      String   @default("")
  vehicle   String   @default("")
  phone     String   @default("")
  createdAt DateTime @default(now())
}

// One row per weekStart — `data` holds the full computed dashboard blob
// (groups/metrics/overviewRows/reports/...) exactly as server.mjs builds it.
model Schedule {
  id        String   @id @default(cuid())
  weekStart String   @unique
  data      Json
  savedAt   DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Attendance {
  id           String    @id
  employeeId   Int
  employeeName String    @default("")
  date         String
  checkIn      DateTime
  checkOut     DateTime?
  method       String    @default("face")
  createdAt    DateTime  @default(now())
}

model DailyStatus {
  id         String   @id
  employeeId Int
  date       String
  statusCode String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([employeeId, date])
}

model AuditLog {
  id        BigInt   @id
  action    String
  entity    String
  entityId  String?
  details   String?
  createdAt DateTime @default(now())
}

model Task {
  id           Int       @id
  title        String
  description  String?
  assignedToId Int
  assignedById Int
  status       String    @default("PENDING")
  rejectReason String?
  dueDate      String?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Notification {
  id        Int      @id
  userId    Int
  title     String
  message   String
  type      String   @default("task")
  isRead    Boolean  @default(false)
  taskId    Int?
  createdAt DateTime @default(now())
}

model Department {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  label     String
  color     String   @default("#6366f1")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

// Single-row table for the global `db.generation` counter.
model AppMeta {
  id         Int @id @default(1)
  generation Int @default(0)
}
